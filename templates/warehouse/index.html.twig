{% extends 'base.html.twig' %}

{% block title %}Warehouse list{% endblock %}

{% block body %}
    <h1>Warehouse list</h1>

    <form method="get" action="{{ path('app_warehouse_index') }}">
        <label for="id">ID:</label>
        <input type="number" id="id" name="id"
               value="{{ filters.id ?? '' }}" min="1">

        <label for="name">Name:</label>
        <input type="text" id="name" name="name"
               value="{{ filters.name ?? '' }}">

        <label for="location">Location:</label>
        <input type="text" id="location" name="location"
               value="{{ filters.location ?? '' }}">

        <label for="description">Description:</label>
        <input type="text" id="description" name="description"
               value="{{ filters.description ?? '' }}">

        <label for="itemsPerPage">Items per page:</label>
        <select id="itemsPerPage" name="itemsPerPage">
            {% for amount in [5, 10, 25, 50, 100] %}
                <option value="{{ amount }}"
                    {% if itemsPerPage == amount %}selected{% endif %}>
                    {{ amount }}
                </option>
            {% endfor %}
        </select>

        <button type="submit">Apply filters</button>
        <a href="{{ path('app_warehouse_index') }}">Reset</a>
    </form>

    <p>Warehouses found: {{ totalItems }}</p>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Location</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for warehouse in warehouses %}
            <tr>
                <td>{{ warehouse.id }}</td>
                <td>{{ warehouse.name }}</td>
                <td>{{ warehouse.location }}</td>
                <td>{{ warehouse.description }}</td>
                <td>
                    <a href="{{ path('app_warehouse_show', {'id': warehouse.id}) }}">Show</a>
                    <a href="{{ path('app_warehouse_edit', {'id': warehouse.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No warehouses found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if totalPages > 1 %}
        <nav aria-label="Pagination">
            {% if page > 1 %}
                <a href="{{ path('app_warehouse_index', app.request.query.all|merge({'page': page - 1})) }}">Previous</a>
            {% endif %}

            <span>Page {{ page }} of {{ totalPages }}</span>

            {% if page < totalPages %}
                <a href="{{ path('app_warehouse_index', app.request.query.all|merge({'page': page + 1})) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}

    <a href="{{ path('app_warehouse_new') }}">Create new warehouse</a>
{% endblock %}