{% extends 'base.html.twig' %}

{% block title %}Supplier list{% endblock %}

{% block body %}
    <h1>Supplier list</h1>

    <form method="get" action="{{ path('app_supplier_index') }}">
        <label for="id">ID:</label>
        <input type="number" id="id" name="id"
               value="{{ filters.id ?? '' }}" min="1">

        <label for="name">Name:</label>
        <input type="text" id="name" name="name"
               value="{{ filters.name ?? '' }}">

        <label for="contactName">Contact name:</label>
        <input type="text" id="contactName" name="contactName"
               value="{{ filters.contactName ?? '' }}">

        <label for="email">Email:</label>
        <input type="text" id="email" name="email"
               value="{{ filters.email ?? '' }}">

        <label for="phone">Phone:</label>
        <input type="text" id="phone" name="phone"
               value="{{ filters.phone ?? '' }}">

        <label for="address">Address:</label>
        <input type="text" id="address" name="address"
               value="{{ filters.address ?? '' }}">

        <label for="itemsPerPage">Items per page:</label>
        <select id="itemsPerPage" name="itemsPerPage">
            {% for amount in [5, 10, 25, 50, 100] %}
                <option value="{{ amount }}"
                    {% if itemsPerPage == amount %}selected{% endif %}>
                    {{ amount }}
                </option>
            {% endfor %}
        </select>

        <button type="submit">Apply filters</button>
        <a href="{{ path('app_supplier_index') }}">Reset</a>
    </form>

    <p>Suppliers found: {{ totalItems }}</p>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Contact name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for supplier in suppliers %}
            <tr>
                <td>{{ supplier.id }}</td>
                <td>{{ supplier.name }}</td>
                <td>{{ supplier.contactName }}</td>
                <td>{{ supplier.email }}</td>
                <td>{{ supplier.phone }}</td>
                <td>{{ supplier.address }}</td>
                <td>
                    <a href="{{ path('app_supplier_show', {'id': supplier.id}) }}">Show</a>
                    <a href="{{ path('app_supplier_edit', {'id': supplier.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">No suppliers found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if totalPages > 1 %}
        <nav aria-label="Pagination">
            {% if page > 1 %}
                <a href="{{ path('app_supplier_index', app.request.query.all|merge({'page': page - 1})) }}">Previous</a>
            {% endif %}

            <span>Page {{ page }} of {{ totalPages }}</span>

            {% if page < totalPages %}
                <a href="{{ path('app_supplier_index', app.request.query.all|merge({'page': page + 1})) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}

    <a href="{{ path('app_supplier_new') }}">Create new supplier</a>
{% endblock %}