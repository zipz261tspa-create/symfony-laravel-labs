{% extends 'base.html.twig' %}

{% block title %}Product list{% endblock %}

{% block body %}
    <h1>Product list</h1>

    <form method="get" action="{{ path('app_product_index') }}">
        <p>
            <label for="id">ID:</label>
            <input type="number" name="id" id="id" value="{{ filters.id }}">
        </p>
        <p>
            <label for="name">Name:</label>
            <input type="text" name="name" id="name" value="{{ filters.name }}">
        </p>
        <p>
            <label for="description">Description:</label>
            <input type="text" name="description" id="description" value="{{ filters.description }}">
        </p>
        <p>
            <label for="price">Price:</label>
            <input type="number" step="0.01" name="price" id="price" value="{{ filters.price }}">
        </p>
        <p>
            <label for="category_id">Category ID:</label>
            <input type="number" min="1" name="category_id" id="category_id" value="{{ filters.category_id }}">
        </p>
        <p>
            <label for="itemsPerPage">Items per page:</label>
            <select name="itemsPerPage" id="itemsPerPage">
                {% for amount in [5, 10, 25, 50, 100] %}
                    <option value="{{ amount }}" {% if itemsPerPage == amount %}selected{% endif %}>
                        {{ amount }}
                    </option>
                {% endfor %}
            </select>
        </p>

        <button type="submit">Apply filters</button>
        <a href="{{ path('app_product_index') }}">Reset</a>
    </form>

    <p>Products found: {{ totalItems }}</p>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.description }}</td>
                <td>{{ product.price }}</td>
                <td>
                    <a href="{{ path('app_product_show', {'id': product.id}) }}">Show</a>
                    <a href="{{ path('app_product_edit', {'id': product.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No products found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if totalPages > 1 %}
        <nav>
            {% if page > 1 %}
                <a href="{{ path('app_product_index', app.request.query.all|merge({'page': page - 1})) }}">Previous</a>
            {% endif %}

            Page {{ page }} of {{ totalPages }}

            {% if page < totalPages %}
                <a href="{{ path('app_product_index', app.request.query.all|merge({'page': page + 1})) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}

    <p><a href="{{ path('app_product_new') }}">Create product</a></p>
{% endblock %}
